# APP_URL: The URL where this application is hosted (AI Studio preview or your Render Web Service URL).
APP_URL="MY_APP_URL"

# Firebase Service Account (Server-side Firestore REST API & Background Scheduler)
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID="gen-lang-client-0302189886"
FIRESTORE_DATABASE_ID="ai-studio-b9d0addf-9235-428d-87b4-d952010d5b26"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Backblaze B2 Private Bucket (S3-Compatible API)
B2_ENDPOINT=""
B2_REGION=""
B2_BUCKET_NAME=""
B2_KEY_ID=""
B2_APPLICATION_KEY=""

# Google OAuth 2.0 & YouTube Data API v3
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# Security Secrets (Server-side Render environment variables only — never prefix with VITE_)
# TOKEN_ENCRYPTION_KEY: 64-character hex string (32 bytes) for AES-256-GCM encryption of OAuth tokens
TOKEN_ENCRYPTION_KEY=""
# CRON_SECRET: Long random bearer token shared between shortspilot-cron-relay Worker and Render POST /api/scheduler/run
CRON_SECRET=""
